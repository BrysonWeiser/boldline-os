# Fonts are self-hosted and content-stable — if a face ever changes, the file is
# renamed, so these can be cached hard. Immutable removes the revalidation entirely.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images change rarely. 30 days (not a year) because these filenames aren't
# content-hashed — a logo swap still needs to reach people in reasonable time.
# Email button pictures. The folder name carries a version (v1), and a new look gets a new folder,
# so a picture at a given address never changes and can be cached for good.
/email/*
  Cache-Control: public, max-age=31536000, immutable
/logo.png
  Cache-Control: public, max-age=2592000
/og-image.png
  Cache-Control: public, max-age=2592000
/og-image.jpg
  Cache-Control: public, max-age=2592000
/og-boldline.jpg
  Cache-Control: public, max-age=2592000
/founder.jpg
  Cache-Control: public, max-age=2592000
/icon.png
  Cache-Control: public, max-age=2592000
/favicon.ico
  Cache-Control: public, max-age=2592000

# HTML/CSS/JS keep Netlify's default revalidation so edits show up immediately.

# Sample websites: a made-up business that shows our work. Never indexed, so Google never mistakes
# BoldLine for a pool company (the pages also carry a robots noindex tag).
/examples/*
  X-Robots-Tag: noindex
